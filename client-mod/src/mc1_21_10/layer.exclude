# The natural-motionblur port needs 1.21.11's LevelRenderer/CameraRenderState
# shape; everything below 1.21.11 keeps its own renderer and shader, which
# this layer carries (motion_blur.json/.fsh live here, not in mc1_21_11).
java/dev/dusk/client/render/motionblur/**
java/dev/dusk/client/mixin/MotionBlurLevelMixin.java
resources/assets/duskclient/post_effect/velocity_pre.json
resources/assets/duskclient/post_effect/velocity_f5.json
resources/assets/duskclient/post_effect/velocity_post.json
resources/assets/duskclient/post_effect/frame_blending.json
resources/assets/duskclient/post_effect/accumulation_max.json
resources/assets/duskclient/post_effect/accumulation_mix.json
resources/assets/duskclient/shaders/post/velocity_pre.fsh
resources/assets/duskclient/shaders/post/velocity_f5.fsh
resources/assets/duskclient/shaders/post/velocity_post.fsh
resources/assets/duskclient/shaders/post/frame_blending.fsh
resources/assets/duskclient/shaders/post/accumulation_max.fsh
resources/assets/duskclient/shaders/post/accumulation_mix.fsh

