{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DuskLauncher",
  "identifier": "app.tryzwork.dusklauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DuskLauncher",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$DATA/FasterLauncher/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwODk5NENBRDIzRDY3Q0UKUldUT1p6M1N5cFNKRUdaNjZDWVdqM2lFdm9TeHVRcDNTUHZGS2UydFdlV2gyQ0hid0VMR2Z3UHQK",
      "endpoints": [
        "https://github.com/ryz3nplayz/dusklauncher/releases/latest/download/latest.json"
      ]
    }
  }
}
