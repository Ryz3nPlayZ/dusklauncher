{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dusklauncher-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "launcher"
      ],
      "port": 5173
    },
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4600",
        "--directory",
        "site"
      ],
      "port": 4600
    }
  ]
}
